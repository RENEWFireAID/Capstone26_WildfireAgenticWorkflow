# Fill in empty values before running

OPENROUTER_API_KEY=

# Set to false to disable insertion into the database from the website
ALLOW_INSERT=true

MONGODB_URI=mongodb://root:password@mongo:27018/?authSource=admin
MONGO_INITDB_ROOT_USERNAME=root
MONGO_INITDB_ROOT_PASSWORD=password

MCP_HTTP_BASE=<fqdn-of-firepoints-mcp-server>
MCP_ALLOWED_HOSTS=localhost,0.0.0.0

RAG_API_URL=http://host.docker.internal:8000/api/retrieve

# --- Google Earth Engine (vegetation trends) ---
# Development: run `earthengine authenticate` once on the host, then set the
# Google Cloud project that has the Earth Engine API enabled.
EE_PROJECT=

# Production (optional): used only when BOTH are set, instead of EE_PROJECT creds.
# EE_KEY_FILE is the path to the service account JSON key *inside the container*.
# Never commit the key file.
EE_SERVICE_ACCOUNT=
EE_KEY_FILE=

# Seconds to wait for an Earth Engine query before giving up (default 120)
GEE_TIMEOUT_SECONDS=120

# Days a cached vegetation time series stays valid (default 30)
VEGETATION_CACHE_TTL_DAYS=30
